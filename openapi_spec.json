{
  "openapi": "3.1.0",
  "info": {
    "title": "Pulse Pressure Variation Calculator API",
    "description": "PPV measurement endpoint and legacy audit-worker interfaces. Legacy audit endpoints are not validated as clinical decision-support systems.",
    "version": "3.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Local server health",
        "responses": {
          "200": {
            "description": "JSON health metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory task counts",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/ppv": {
      "post": {
        "summary": "Calculate PPV from PP extrema or paired BP measurements",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pp_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pp_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "sbp_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "dbp_max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "sbp_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "dbp_min": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "description": "Supply both PP fields, or all four paired BP fields, in mmHg."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PPmax, PPmin, PPmean (mmHg), PPV percent"
          },
          "422": {
            "description": "Invalid or incomplete measurement input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic worker audit",
        "responses": {
          "200": {
            "description": "Legacy dossier"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy deterministic mock response",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory legacy audit signatures and chain check",
        "responses": {
          "200": {
            "description": "Audit chain and verification status"
          }
        }
      }
    }
  }
}
